# Copy to .env on the deployment server. Never commit .env.
DOMAIN=your-domain.example
# Replace with a unique, randomly generated secret of at least 16 characters.
ADMIN_PASSWORD=

# Optional social login app credentials. Leave blank to keep buttons disabled.
# Configure exact HTTPS callbacks listed in README with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
ZALO_APP_ID=
ZALO_APP_SECRET=
